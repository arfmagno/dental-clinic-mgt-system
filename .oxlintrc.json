{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "import", "unicorn", "vitest", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": { "browser": true, "node": true, "es2024": true },
  "rules": {
    "eqeqeq": ["error", "smart"],
    "no-console": "off",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "destructuredArrayIgnorePattern": "^_", "ignoreRestSiblings": true }],
    "typescript/no-explicit-any": "warn",
    "typescript/consistent-type-imports": "error",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "react/jsx-key": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-cycle": "off",
    "import/no-unassigned-import": "off",
    "import/no-named-as-default": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/consistent-function-scoping": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "e2e/**"],
      "rules": { "typescript/no-explicit-any": "off", "typescript/no-non-null-assertion": "off", "vitest/require-mock-type-parameters": "off", "unicorn/prefer-add-event-listener": "off" }
    }
  ],
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/dev-dist/**", "**/data/**", "**/release/**", "**/playwright-report/**", "**/test-results/**"]
}
